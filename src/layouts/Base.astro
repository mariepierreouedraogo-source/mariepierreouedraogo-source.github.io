---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { profile, pillars, seo } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** Exclut la page des résultats de recherche (ex. 404). */
  noindex?: boolean;
}

const { title = seo.title, description = seo.description, noindex = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL(`${base}/`, Astro.site).href;

// Données structurées : aident Google à relier le site à la personne, au lieu et aux réseaux.
const sameAs = Object.values(profile.socials).filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${home}#personne`,
      name: profile.name,
      alternateName: seo.alternateNames,
      jobTitle: profile.role,
      description: seo.description,
      url: home,
      email: `mailto:${profile.email}`,
      address: { '@type': 'PostalAddress', addressLocality: seo.city, addressCountry: seo.countryCode },
      knowsAbout: pillars.flatMap((p) => p.groups.flatMap((g) => g.items)),
      ...(sameAs.length ? { sameAs } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#site`,
      name: profile.name,
      url: home,
      inLanguage: 'fr',
      publisher: { '@id': `${home}#personne` },
    },
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    {seo.googleSiteVerification && <meta name="google-site-verification" content={seo.googleSiteVerification} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#0a0f1a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f8fb" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Thème appliqué avant le rendu pour éviter le flash. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        d.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
