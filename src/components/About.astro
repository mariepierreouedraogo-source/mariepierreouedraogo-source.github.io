---
import { about, profile, languages } from '../data/profile';
---

<section class="section" id="a-propos">
  <div class="container grid">
    <div class="section-head" data-reveal>
      <p class="eyebrow">01 · À propos</p>
      <h2 class="section-title">Du câble à l'écran</h2>
    </div>

    <div class="body" data-reveal>
      {about.paragraphs.map((p) => <p>{p}</p>)}

      <dl class="langs">
        {
          languages.map((l) => (
            <div>
              <dt>{l.name}</dt>
              <dd>{l.level}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <ul role="list" class="highlights" data-reveal aria-label={`Points clés du profil de ${profile.name}`}>
      {
        about.highlights.map((h) => (
          <li class="card">
            <span class="label">{h.label}</span>
            <span class="value">{h.value}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    column-gap: clamp(32px, 6vw, 80px);
  }
  .section-head {
    margin-bottom: 0;
  }
  .body {
    display: grid;
    gap: 18px;
    color: var(--text-muted);
    font-size: 1.05rem;
  }
  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin-top: 6px;
    font-size: 0.92rem;
  }
  .langs div {
    display: flex;
    gap: 8px;
  }
  .langs dt {
    color: var(--text);
    font-weight: 600;
  }
  .langs dd::before {
    content: '— ';
    color: var(--text-faint);
  }
  .highlights {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: clamp(40px, 6vw, 64px);
  }
  .highlights li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px;
  }
  .highlights li:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    transform: translateY(-3px);
  }
  .label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .value {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .section-head {
      margin-bottom: 24px;
    }
    .highlights {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 420px) {
    .highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
