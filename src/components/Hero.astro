---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const firstName = profile.name.split(' ')[0];
---

<section class="hero" id="top">
  <canvas class="net" data-network aria-hidden="true"></canvas>
  <div class="glow" aria-hidden="true"></div>

  <div class="container grid">
    <div class="intro">
      <p class="status">
        <span class="dot" aria-hidden="true"></span>
        {profile.availability}
      </p>

      <h1>
        <span class="hello">Bonjour, je suis</span>
        <span class="name">{profile.name}</span>
      </h1>

      <p class="role">
        {profile.role.split(' · ').map((part, i, all) => (
          <span>{part}{i < all.length - 1 && <span class="sep" aria-hidden="true">·</span>}</span>
        ))}
      </p>
      <p class="tagline">{profile.tagline}</p>

      <div class="ctas">
        <a href="#projets" class="btn btn-primary">
          Voir mes projets <Icon name="arrow" />
        </a>
        <a href="#contact" class="btn">Me contacter</a>
        {
          profile.cv && (
            <a href={`${base}/${profile.cv}`} class="btn" download>
              <Icon name="download" /> CV
            </a>
          )
        }
      </div>

      <ul role="list" class="meta">
        {
          profile.location && (
            <li>
              <Icon name="pin" size={16} /> {profile.location}
            </li>
          )
        }
        {
          profile.socials.github && (
            <li>
              <a href={profile.socials.github} target="_blank" rel="noopener">
                <Icon name="github" size={16} /> GitHub
              </a>
            </li>
          )
        }
        {
          profile.socials.linkedin && (
            <li>
              <a href={profile.socials.linkedin} target="_blank" rel="noopener">
                <Icon name="linkedin" size={16} /> LinkedIn
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <div
      class="term card"
      role="img"
      aria-label="Terminal décoratif résumant mes compétences : web, mobile, réseaux et programmation"
    >
      <div class="term-bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <code>~/portfolio</code>
      </div>
      <pre class="term-body" aria-hidden="true"><code><span class="l" style="--d:0"><span class="p">$</span> whoami</span>
<span class="l o" style="--d:1">{firstName.toLowerCase()}</span>
<span class="l" style="--d:2"><span class="p">$</span> cat competences.txt</span>
<span class="l o" style="--d:3"><span class="k">web</span>      HTML · CSS · JS · PHP</span>
<span class="l o" style="--d:4"><span class="k">mobile</span>   Android · Flutter</span>
<span class="l o" style="--d:5"><span class="k">réseaux</span>  VLAN · routage · VoIP</span>
<span class="l o" style="--d:6"><span class="k">code</span>     Java · Python · SQL</span>
<span class="l" style="--d:7"><span class="p">$</span> ping prochain-projet</span>
<span class="l o ok" style="--d:8">64 bytes: icmp_seq=1 ttl=64 time=0.42 ms</span>
<span class="l" style="--d:9"><span class="p">$</span> <span class="cursor"></span></span></code></pre>
    </div>
  </div>

  <a href="#a-propos" class="scroll-hint" aria-label="Défiler vers la section À propos">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--header-h) + 48px) 96px;
    overflow: hidden;
    isolation: isolate;
  }
  .net {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0.9;
    mask-image: radial-gradient(ellipse 90% 80% at 70% 40%, #000 30%, transparent 85%);
  }
  .glow {
    position: absolute;
    z-index: -2;
    width: 720px;
    height: 720px;
    right: -180px;
    top: -200px;
    background: radial-gradient(circle, var(--accent-soft), transparent 65%);
    filter: blur(20px);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 28px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); }
    70% { box-shadow: 0 0 0 10px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hello {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    color: var(--accent);
    letter-spacing: 0;
  }
  .name {
    font-size: clamp(2.6rem, 7vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    background: linear-gradient(120deg, var(--text) 30%, var(--accent) 110%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .role {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 500;
  }
  .role > span {
    display: inline-block;
    white-space: nowrap;
  }
  .sep {
    margin-inline: 0.4em;
    color: var(--accent);
  }
  .tagline {
    margin-top: 14px;
    max-width: 54ch;
    color: var(--text-muted);
    font-size: 1.05rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 28px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .meta li,
  .meta a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .meta a:hover {
    color: var(--accent);
  }

  /* Terminal */
  .term {
    overflow: hidden;
    box-shadow: var(--shadow);
    background: color-mix(in srgb, var(--bg-elev) 85%, transparent);
    backdrop-filter: blur(8px);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }
  .term-bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .term-bar span:nth-child(1) { background: #f87171; }
  .term-bar span:nth-child(2) { background: #fbbf24; }
  .term-bar span:nth-child(3) { background: #34d399; }
  .term-bar code {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }
  .term-body {
    padding: 20px 20px 24px;
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1.1vw, 0.84rem);
    line-height: 1.85;
    overflow-x: auto;
    white-space: pre;
  }
  .l {
    display: inline-block;
    animation: line-in 0.4s var(--ease) both;
    animation-delay: calc(0.35s + var(--d) * 0.28s);
  }
  @media (prefers-reduced-motion: reduce) {
    .l {
      animation: none;
    }
  }
  @keyframes line-in {
    from { opacity: 0; transform: translateX(-6px); }
  }
  .p { color: var(--accent); }
  .o { color: var(--text-muted); }
  .k {
    color: var(--accent-2);
  }
  .ok { color: var(--accent); }
  .cursor {
    display: inline-block;
    width: 8px;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    width: 26px;
    height: 42px;
    border-radius: 999px;
    border: 1.5px solid var(--border-strong);
    display: flex;
    justify-content: center;
    padding-top: 8px;
  }
  .scroll-hint span {
    width: 3px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
    animation: scroll 1.8s var(--ease) infinite;
  }
  @keyframes scroll {
    0% { transform: translateY(0); opacity: 1; }
    80% { transform: translateY(12px); opacity: 0; }
    100% { opacity: 0; }
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .term {
      max-width: 520px;
    }
    .scroll-hint {
      display: none;
    }
  }
</style>
