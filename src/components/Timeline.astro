---
import Icon from './Icon.astro';
import { timeline } from '../data/profile';

const icons = {
  formation: 'graduation',
  experience: 'briefcase',
  certification: 'award',
} as const;
const kinds = {
  formation: 'Formation',
  experience: 'Expérience',
  certification: 'Certification',
};
---

<section class="section alt" id="parcours">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">04 · Parcours</p>
      <h2 class="section-title">Formation & expériences</h2>
    </div>

    <ol class="timeline">
      {
        timeline.map((t) => (
          <li data-reveal>
            <span class="node" aria-hidden="true">
              <Icon name={icons[t.kind]} size={18} />
            </span>
            <div class="content card">
              <div class="head">
                <span class="period">{t.period}</span>
                <span class="kind">{kinds[t.kind]}</span>
              </div>
              <h3>{t.title}</h3>
              <p class="place">{t.place}</p>
              {t.description && <p class="desc">{t.description}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .alt {
    background: var(--bg-soft);
    border-block: 1px solid var(--border);
  }
  .timeline {
    list-style: none;
    padding: 0;
    position: relative;
    display: grid;
    gap: 20px;
    max-width: 820px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(var(--accent), var(--border) 70%, transparent);
  }
  li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 20px;
    align-items: start;
  }
  .node {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg-elev);
    border: 2px solid var(--accent);
    color: var(--accent);
  }
  .content {
    padding: 22px 24px;
  }
  .content:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }
  .period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
  .kind {
    font-size: 0.75rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  h3 {
    font-size: 1.15rem;
  }
  .place {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-top: 2px;
  }
  .desc {
    margin-top: 10px;
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  @media (max-width: 520px) {
    li {
      grid-template-columns: 36px 1fr;
      gap: 14px;
    }
    .node {
      width: 36px;
      height: 36px;
    }
    .node :global(svg) {
      width: 15px;
      height: 15px;
    }
    .timeline::before {
      left: 17px;
    }
  }
</style>
