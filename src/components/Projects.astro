---
import Icon from './Icon.astro';
import { projects, categories, type Category } from '../data/profile';

const used = (Object.keys(categories) as Category[]).filter((c) =>
  projects.some((p) => p.category === c),
);
const filters = [
  { id: 'all', label: 'Tous', count: projects.length },
  ...used.map((c) => ({
    id: c,
    label: categories[c],
    count: projects.filter((p) => p.category === c).length,
  })),
];
---

<section class="section" id="projets">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">03 · Projets</p>
      <h2 class="section-title">Ce que j'ai construit</h2>
      <p class="section-lead">
        Une sélection de réalisations en développement, en réseaux et en programmation.
      </p>
    </div>

    <div class="filters" role="group" aria-label="Filtrer les projets" data-reveal>
      {
        filters.map((f, i) => (
          <button type="button" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label}
            <span class="count">{f.count}</span>
          </button>
        ))
      }
    </div>

    <p class="sr-only" aria-live="polite" data-filter-status></p>

    <ul role="list" class="grid">
      {
        projects.map((p) => (
          <li class="project card" data-category={p.category} data-reveal>
            <div class="top">
              <span class={`badge badge-${p.category}`}>{categories[p.category]}</span>
              {p.year && <span class="year">{p.year}</span>}
            </div>
            <h3>{p.title}</h3>
            <p class="summary">{p.summary}</p>
            <ul class="points">
              {p.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <ul role="list" class="stack" aria-label="Technologies">
              {p.stack.map((s) => (
                <li class="tag">{s}</li>
              ))}
            </ul>
            {(p.links?.code || p.links?.demo) && (
              <div class="links">
                {p.links?.code && (
                  <a href={p.links.code} target="_blank" rel="noopener">
                    <Icon name="github" size={16} /> Code
                    <span class="sr-only"> de {p.title}</span>
                  </a>
                )}
                {p.links?.demo && (
                  <a href={p.links.demo} target="_blank" rel="noopener">
                    <Icon name="external" size={16} /> Démo
                    <span class="sr-only"> de {p.title}</span>
                  </a>
                )}
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }
  .filters button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s var(--ease);
  }
  .filters button:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
  .filters button[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }
  .project {
    display: flex;
    flex-direction: column;
    padding: 26px;
  }
  .project[hidden] {
    display: none;
  }
  .project:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  .badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .badge-reseau,
  .badge-mobile {
    background: var(--accent-2-soft);
    color: var(--accent-2);
  }
  .year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }
  h3 {
    font-size: 1.2rem;
  }
  .summary {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .points {
    margin-top: 14px;
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: 0.9rem;
  }
  .points li {
    position: relative;
    padding-left: 18px;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--accent);
    opacity: 0.7;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 20px;
  }
  .links {
    display: flex;
    gap: 18px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
